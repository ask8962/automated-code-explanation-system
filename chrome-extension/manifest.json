{
    "manifest_version": 3,
    "name": "Automated Code Explanation System",
    "version": "1.0",
    "description": "Empowering students to understand and optimize code instantly using AI.",
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "https://gla-code-aa.vercel.app/*",
        "*://github.com/*",
        "*://leetcode.com/*",
        "*://stackoverflow.com/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Explain Code"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "*://github.com/*",
                "*://leetcode.com/*",
                "*://stackoverflow.com/*"
            ],
            "css": [
                "content.css"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}