rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is accessing their own data
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Rules for Code Explanations collection
    match /codeExplanations/{docId} {
      // Allow create if authenticated and the userId matches the auth uid
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      
      // Allow read, update, delete if the document belongs to the user
      allow read, update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
